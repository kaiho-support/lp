        <tr><td class="n">09</td><td class="t">絵画</td><td class="e">PAINTINGS</td></tr>
        <tr><td class="n">10</td><td class="t">美術装飾品</td><td class="e">DECORATIVE ART</td></tr>
        <tr><td class="n">11</td><td class="t">その他美術品</td><td class="e">OTHER WORKS</td></tr>
