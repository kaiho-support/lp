---
import { Image, getImage } from 'astro:assets';
import heroChest from '../assets/hero-chest.webp';
import itemMoonjar from '../assets/item-moonjar.webp';
import itemTea from '../assets/item-tea.webp';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const faviconUrl = `${base}favicon.svg`;

const ogImage = await getImage({ src: heroChest, width: 1200, format: 'jpg' });
const ogImageUrl = new URL(ogImage.src, 'https://kaihojpn.com').href;

const company = {
  name: '株式会社 開豊ジャパン',
  storeName: 'Galleria 李朝',
  representative: '金 載文',
  postalCode: '193-0935',
  address: '東京都八王子市大船町142-6',
  telDisplay: '042-667-7005',
  telLink: 'tel:+81426677005',
  email: 'info@kaihojpn.com',
  hours: '10:00〜17:00',
  closed: '土・日・祝日',
  license: '東京都公安委員会 第308770205133号（古物商許可証）',
};

const items = [
  '東洋美術',
  '西洋美術',
  '日本陶磁器',
  '中国陶磁器',
  '茶道具',
  '花道具',
  '諸道具',
  '掛軸',
  '絵画',
  '美術装飾品',
  'その他美術品',
];

const marqueeWords = ['李朝家具', '東洋美術', '陶磁器', '茶道具', '掛軸', '絵画', 'Galleria 李朝'];
const marqueeSeq = [...marqueeWords, ...marqueeWords];

const storeUrl = 'https://auctions.yahoo.co.jp/seller/2TBbYXSSF6rHaqSv7EVuJg1R9X8gD';
const mapsUrl =
  'https://www.google.com/maps/search/?api=1&query=%E6%A0%AA%E5%BC%8F%E4%BC%9A%E7%A4%BE%E9%96%8B%E8%B1%8A%E3%82%B8%E3%83%A3%E3%83%91%E3%83%B3%20%E6%9D%B1%E4%BA%AC%E9%83%BD%E5%85%AB%E7%8E%8B%E5%AD%90%E5%B8%82%E5%A4%A7%E8%88%B9%E7%94%BA142-6';

const title = '開豊ジャパン｜八王子の古美術店';
const description =
  '東京都八王子市の古美術店、株式会社開豊ジャパン。李朝家具をはじめ東洋美術・陶磁器・茶道具などを取り扱い、Yahoo!オークションストア「Galleria 李朝」で販売しています。会社概要と取扱品目のご案内です。';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'AntiqueStore',
  name: company.name,
  url: 'https://kaihojpn.com/lp/',
  telephone: '+81-42-667-7005',
  email: company.email,
  address: {
    '@type': 'PostalAddress',
    postalCode: company.postalCode,
    addressRegion: '東京都',
    addressLocality: '八王子市',
    streetAddress: '大船町142-6',
    addressCountry: 'JP',
  },
  openingHoursSpecification: {
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
    opens: '10:00',
    closes: '17:00',
  },
};
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href="https://kaihojpn.com/lp/" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content="https://kaihojpn.com/lp/" />
    <meta property="og:image" content={ogImageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/svg+xml" href={faviconUrl} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <style>
      :root {
        --ink: #1d1d1b;
        --ink-soft: #55534d;
        --paper: #f5f3ee;
        --white: #fcfbf7;
        --line: #dbd7cc;
        --line-dark: #b7b2a4;
        --night: #101010;
        --moon: #ece8df;
        --moon-soft: #a49e90;
        --ease: cubic-bezier(0.22, 0.61, 0.21, 1);
      }
      * { box-sizing: border-box; }
      html { scroll-behavior: smooth; }
      html, body { overflow-x: clip; }
      body {
        margin: 0;
        color: var(--ink);
        background: var(--paper);
        font-family: "Didot", "Bodoni MT", "Bodoni 72",
          "Hiragino Mincho ProN", "Hiragino Mincho Pro",
          "YuMincho", "Yu Mincho",
          "Noto Serif CJK JP", "Noto Serif JP", "MS PMincho", serif;
        font-size: 16px;
        line-height: 1.95;
        letter-spacing: 0.04em;
        -webkit-font-smoothing: antialiased;
        text-rendering: optimizeLegibility;
      }
      h1, h2, .catch, .store-name { font-feature-settings: "palt"; }
      a { color: inherit; }
      a:focus-visible { outline: 2px solid currentColor; outline-offset: 3px; }
      img { display: block; max-width: 100%; height: auto; }
      ::selection { background: var(--ink); color: var(--moon); }
      .skip {
        position: absolute; left: -9999px; top: 0; z-index: 40;
        background: var(--moon); color: var(--night); padding: 0.5rem 1rem;
      }
      .skip:focus { left: 0; }
      .wrap { max-width: 1060px; margin: 0 auto; padding: 0 24px; }
      .en {
        font-family: "Hiragino Kaku Gothic ProN", "Hiragino Sans",
          "Yu Gothic UI", "YuGothic", "Noto Sans CJK JP", sans-serif;
        text-transform: uppercase;
      }
      .num { font-variant-numeric: tabular-nums; }

      #progress {
        position: fixed; top: 0; left: 0; z-index: 30;
        width: 100%; height: 2px; background: #8a8474;
        transform: scaleX(0); transform-origin: left;
      }

      /* ---------- header ---------- */
      header {
        position: sticky; top: 0; z-index: 10;
        background: color-mix(in srgb, var(--night) 94%, transparent);
        backdrop-filter: blur(8px);
        border-bottom: 1px solid #2b2b29;
        color: var(--moon);
      }
      .header-in {
        display: flex; align-items: baseline; justify-content: space-between;
        gap: 1rem; padding-top: 15px; padding-bottom: 15px;
      }
      .brand { text-decoration: none; display: flex; align-items: baseline; gap: 0.75rem; }
      .brand-name { font-size: 1.22rem; letter-spacing: 0.2em; }
      .brand-sub { font-size: 0.6rem; letter-spacing: 0.34em; color: var(--moon-soft); }
      nav ul { display: flex; gap: 1.7rem; list-style: none; margin: 0; padding: 0; }
      nav a { text-decoration: none; font-size: 0.85rem; letter-spacing: 0.14em; color: #cfcabe; }
      nav a:hover { color: #fff; text-decoration: underline; text-underline-offset: 5px; }
      @media (max-width: 760px) { nav { display: none; } }

      /* ---------- hero（B案の原形：写真の帯＋下の黒タイトル帯。写真への重ね塗りはしない） ---------- */
      .hero {
        position: relative; background: var(--night); color: var(--moon);
        min-height: calc(100svh - 57px); display: flex; flex-direction: column;
        overflow: clip;
      }
      .hero-media { position: relative; height: 55svh; flex: none; overflow: clip; }
      .hero-media img {
        width: 100%; height: 100%; object-fit: cover; object-position: center 42%;
      }
      .hero-ghost {
        position: absolute; top: 30svh; right: 1.5rem; z-index: 3;
        writing-mode: vertical-rl; pointer-events: none;
        font-size: clamp(4.6rem, 13vw, 9.5rem); letter-spacing: 0.08em; line-height: 1;
        color: rgba(236,232,223,0.05);
        -webkit-text-stroke: 1px rgba(236,232,223,0.16);
        user-select: none; will-change: transform;
      }
      .hero-inner {
        position: relative; z-index: 2; flex: 1; width: 100%;
        max-width: 1060px; margin: 0 auto; padding: 52px 24px 92px;
        display: flex; flex-direction: column; justify-content: center;
      }
      .hero .label {
        font-size: 0.66rem; letter-spacing: 0.44em; color: #d8d2c2; margin: 0 0 1.8rem;
        animation: fadeIn 1.2s var(--ease) 0.9s both;
      }
      .hero h1 {
        font-size: clamp(2.3rem, 6.4vw, 4rem); font-weight: 500;
        line-height: 1.5; letter-spacing: 0.1em; margin: 0 0 1.6rem; color: #f6f3ec;
      }
      .hero h1 .line { display: block; overflow: hidden; }
      .hero h1 .line > span {
        display: block; transform: translateY(110%);
        animation: riseUp 1.1s var(--ease) both;
      }
      .hero h1 .line:nth-child(1) > span { animation-delay: 0.15s; }
      .hero h1 .line:nth-child(2) > span { animation-delay: 0.32s; }
      @keyframes riseUp { to { transform: translateY(0); } }
      @keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
      .hero .catch {
        font-size: clamp(1.12rem, 2.6vw, 1.45rem); letter-spacing: 0.12em; margin: 0 0 1.2rem;
        animation: fadeIn 1.2s var(--ease) 1.05s both;
      }
      .hero .lead {
        max-width: 36em; margin: 0 0 2.6rem; color: #d5d0c1; font-size: 0.98rem;
        animation: fadeIn 1.2s var(--ease) 1.2s both;
      }
      .hero .cta-row { animation: fadeIn 1.2s var(--ease) 1.35s both; }
      .scroll-hint {
        position: absolute; left: 50%; bottom: 18px; transform: translateX(-50%); z-index: 2;
        display: flex; flex-direction: column; align-items: center; gap: 8px;
        font-size: 0.58rem; letter-spacing: 0.42em; color: var(--moon-soft);
        animation: fadeIn 1.2s var(--ease) 1.8s both;
      }
      .scroll-hint .wire {
        width: 1px; height: 44px; background: rgba(236,232,223,0.65);
        transform-origin: top; animation: wire 2.4s var(--ease) infinite;
      }
      @keyframes wire { 0% { transform: scaleY(0); } 45% { transform: scaleY(1); } 100% { transform: scaleY(1); opacity: 0; } }

      .btn {
        display: inline-block; text-decoration: none; cursor: pointer;
        padding: 0.95rem 2.4rem; font-size: 0.9rem; letter-spacing: 0.16em;
        border: 1px solid var(--ink); background: var(--ink); color: var(--white);
        transition: background 0.25s, color 0.25s, border-color 0.25s;
      }
      .btn:hover { background: transparent; color: var(--ink); }
      .btn.on-dark { border-color: var(--moon); background: var(--moon); color: var(--night); }
      .btn.on-dark:hover { background: transparent; color: var(--moon); }
      .btn.ghost { background: transparent; color: var(--ink); }
      .btn.ghost:hover { background: var(--ink); color: var(--white); }

      /* ---------- marquee ---------- */
      .marquee {
        background: var(--night); color: var(--moon);
        border-top: 1px solid #2b2b29; overflow: clip; padding: 15px 0 17px;
      }
      .marquee-track {
        display: flex; width: max-content; gap: 0;
        animation: marquee 30s linear infinite;
      }
      .marquee-track .mq {
        font-size: 0.92rem; letter-spacing: 0.3em; white-space: nowrap; padding-right: 2.4em;
      }
      .marquee-track .mq-dot { color: var(--moon-soft); padding-left: 2.4em; }
      @keyframes marquee { to { transform: translateX(-50%); } }

      /* ---------- sections ---------- */
      section { padding: 88px 0; border-bottom: 1px solid var(--line); }
      section.alt { background: var(--white); }
      .sec-head { display: flex; align-items: baseline; gap: 1.4rem; margin-bottom: 2.8rem; }
      .sec-head .en { font-size: 0.64rem; letter-spacing: 0.4em; color: var(--ink-soft); }
      .sec-head h2 { font-size: 1.55rem; font-weight: 500; letter-spacing: 0.12em; margin: 0; }
      .sec-head::after { content: ""; flex: 1; border-top: 1px solid var(--line); transform: translateY(-4px); }
      .body-text { max-width: 40em; color: var(--ink-soft); }
      .body-text p { margin: 0 0 1.2em; }
      figure.photo { margin: 0; }
      figure.photo figcaption { font-size: 0.72rem; letter-spacing: 0.22em; color: var(--ink-soft); padding-top: 0.7rem; }

      .items-layout { display: grid; grid-template-columns: 1fr 400px; gap: 3.2rem; align-items: start; }
      @media (max-width: 860px) { .items-layout { grid-template-columns: 1fr; } }
      .items { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line-dark); }
      .items li {
        display: flex; align-items: baseline; gap: 1.3rem;
        padding: 0.95rem 0.2rem; border-bottom: 1px solid var(--line);
        font-size: 1.02rem; letter-spacing: 0.12em;
      }
      .items .idx {
        font-family: "Didot", "Bodoni MT", "Bodoni 72", "Hiragino Mincho ProN", serif;
        font-size: 0.95rem; color: var(--ink-soft); min-width: 2em;
      }

      .shop-layout { display: grid; grid-template-columns: 400px 1fr; gap: 3.2rem; align-items: center; }
      @media (max-width: 860px) { .shop-layout { grid-template-columns: 1fr; } }
      .store-name { font-size: 1.65rem; letter-spacing: 0.14em; margin: 0 0 1rem; font-weight: 500; }
      .shop-layout .body-text { margin-bottom: 2rem; }

      table.profile { width: 100%; border-collapse: collapse; background: var(--white); }
      table.profile th, table.profile td {
        border: 1px solid var(--line); padding: 1.05rem 1.25rem;
        text-align: left; vertical-align: top; font-size: 0.96rem;
      }
      table.profile th { width: 11em; font-weight: 500; letter-spacing: 0.12em; background: var(--paper); }
      table.profile a:hover { text-underline-offset: 4px; }

      .contact-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 1.2rem; margin-top: 2.2rem; }
      .contact-card { border: 1px solid var(--line); background: var(--white); padding: 1.8rem; }
      .contact-card .k { font-size: 0.62rem; letter-spacing: 0.36em; color: var(--ink-soft); margin: 0 0 0.6rem; }
      .contact-card .v { font-size: 1.3rem; letter-spacing: 0.06em; margin: 0; }
      .contact-card .v a { text-decoration: none; }
      .contact-card .v a:hover { text-decoration: underline; text-underline-offset: 5px; }
      .note { color: var(--ink-soft); font-size: 0.88rem; margin-top: 1.6rem; }

      footer { background: var(--night); color: var(--moon); padding: 58px 0 64px; }
      .footer-in { display: flex; flex-wrap: wrap; gap: 0.8rem 2.6rem; justify-content: space-between; align-items: baseline; }
      footer .fname { letter-spacing: 0.2em; font-size: 1.05rem; }
      footer small { color: var(--moon-soft); letter-spacing: 0.05em; }

      /* ---------- scroll reveal (JSがある時だけ初期状態を隠す) ---------- */
      .js [data-reveal] {
        opacity: 0; transform: translateY(28px);
        transition: opacity 0.9s var(--ease), transform 0.9s var(--ease);
        transition-delay: var(--d, 0s);
      }
      /* 画像リビールは clip-path を内側の img に付ける（観測対象の figure 自体に付けると
         IntersectionObserver が「表示されていない」と判定し永遠に発火しないため） */
      .js [data-reveal="img"] { opacity: 1; transform: none; transition: none; }
      .js [data-reveal="img"] img { clip-path: inset(0 0 100% 0); transition: clip-path 1.15s var(--ease); }
      .js [data-reveal="img"] figcaption { opacity: 0; transition: opacity 0.8s var(--ease) 0.35s; }
      .js [data-reveal].in { opacity: 1; transform: none; }
      .js [data-reveal="img"].in img { clip-path: inset(0 0 0% 0); }
      .js [data-reveal="img"].in figcaption { opacity: 1; }

      @media (max-width: 640px) {
        section { padding: 64px 0; }
        .hero-media { height: 42svh; }
        .hero-ghost { top: 24svh; right: 0.9rem; }
        .hero-inner { padding: 40px 20px 88px; }
        .hero .lead { font-size: 0.94rem; }
        .hero .cta-row .btn { display: block; text-align: center; }
        .sec-head { flex-wrap: wrap; row-gap: 0.2rem; }
        .sec-head h2 { white-space: nowrap; }
        .sec-head::after { flex-basis: 100%; }
        table.profile th, table.profile td { display: block; width: auto; }
        table.profile th { border-bottom: none; padding-bottom: 0.2rem; }
        table.profile td { border-top: none; padding-top: 0.2rem; }
      }

      @media (prefers-reduced-motion: reduce) {
        html { scroll-behavior: auto; }
        *, *::before, *::after {
          animation-duration: 0.01ms !important; animation-iteration-count: 1 !important;
          transition-duration: 0.01ms !important;
        }
        .js [data-reveal] { opacity: 1; transform: none; clip-path: none; }
        .hero h1 .line > span { transform: none; }
      }
    </style>
  </head>
  <body>
    <a class="skip" href="#main">本文へ移動</a>
    <div id="progress" aria-hidden="true"></div>
    <header>
      <div class="wrap header-in">
        <a class="brand" href="#top" aria-label="開豊ジャパン トップへ">
          <span class="brand-name">開豊ジャパン</span>
          <span class="brand-sub en">Antique Store</span>
        </a>
        <nav aria-label="ページ内案内">
          <ul>
            <li><a href="#items">取扱品目</a></li>
            <li><a href="#shop">ショップ</a></li>
            <li><a href="#company">会社概要</a></li>
            <li><a href="#access">アクセス</a></li>
            <li><a href="#contact">お問い合わせ</a></li>
          </ul>
        </nav>
      </div>
    </header>

    <main id="main">
      <div class="hero" id="top">
        <div class="hero-media" id="heroMedia">
          <Image
            src={heroChest}
            alt="暗い展示室でスポットライトを受ける李朝の木製箪笥"
            widths={[828, 1200, 1920, 2352]}
            sizes="100vw"
            loading="eager"
            fetchpriority="high"
          />
        </div>
        <div class="hero-ghost" id="heroGhost" aria-hidden="true">古美術</div>
        <div class="hero-inner">
          <p class="label en">Hachioji, Tokyo — Antique Dealer</p>
          <h1>
            <span class="line"><span>八王子の古美術店</span></span>
            <span class="line"><span>開豊ジャパン</span></span>
          </h1>
          <p class="catch">『美術品取引をより身近に』</p>
          <p class="lead">
            設立以来変わらぬ思いで、家具、美術品、道具――カテゴリにとらわれることなく、美術品とお客様の取引を身近にするお手伝いをさせていただきます。
          </p>
          <div class="cta-row">
            <a class="btn on-dark" href={storeUrl} rel="noopener" target="_blank">出品一覧を見る（<span style="white-space:nowrap">Yahoo!オークション</span>）</a>
          </div>
        </div>
        <div class="scroll-hint en" aria-hidden="true">Scroll<span class="wire"></span></div>
      </div>

      <div class="marquee" aria-hidden="true">
        <div class="marquee-track">
          {marqueeSeq.map((w) => <span class="mq">{w}<span class="mq-dot">・</span></span>)}
        </div>
      </div>

      <section id="items" aria-labelledby="items-h">
        <div class="wrap">
          <div class="sec-head" data-reveal>
            <span class="en">Items</span>
            <h2 id="items-h">取扱品目</h2>
          </div>
          <div class="items-layout">
            <div>
              <div class="body-text" data-reveal>
                <p>ジャンルにとらわれず、新たな価値を見出し、提供します。</p>
              </div>
              <ol class="items">
                {
                  items.map((name, i) => (
                    <li data-reveal style={`--d:${i * 55}ms`}>
                      <span class="idx num">{String(i + 1).padStart(2, '0')}</span>
                      {name}
                    </li>
                  ))
                }
              </ol>
            </div>
            <figure class="photo" data-reveal="img">
              <Image
                src={itemMoonjar}
                alt="台座の上に置かれた李朝白磁の大壺"
                widths={[480, 800, 1200]}
                sizes="(max-width: 860px) 100vw, 400px"
                loading="lazy"
              />
              <figcaption>李朝白磁</figcaption>
            </figure>
          </div>
        </div>
      </section>

      <section id="shop" class="alt" aria-labelledby="shop-h">
        <div class="wrap">
          <div class="sec-head" data-reveal>
            <span class="en">Shop</span>
            <h2 id="shop-h">オンラインショップ</h2>
          </div>
          <div class="shop-layout">
            <figure class="photo" data-reveal="img">
              <Image
                src={itemTea}
                alt="木の盆に置かれた茶碗、茶筅と鉄瓶"
                widths={[480, 800, 1200]}
                sizes="(max-width: 860px) 100vw, 400px"
                loading="lazy"
              />
              <figcaption>茶道具</figcaption>
            </figure>
            <div data-reveal>
              <h3 class="store-name">{company.storeName}</h3>
              <div class="body-text">
                <p>最良の美術品を、より身近な方法でお届けします。商品はYahoo!オークションで販売しています。</p>
                <p>李朝家具、古美術品、雑貨などを出品しています。出品中の商品は、出品一覧からご覧いただけます。</p>
              </div>
              <a class="btn" href={storeUrl} rel="noopener" target="_blank">Galleria 李朝の出品一覧</a>
            </div>
          </div>
        </div>
      </section>

      <section id="company" aria-labelledby="company-h">
        <div class="wrap">
          <div class="sec-head" data-reveal>
            <span class="en">About us</span>
            <h2 id="company-h">会社概要</h2>
          </div>
          <div data-reveal>
            <table class="profile">
              <tbody>
                <tr><th scope="row">社名</th><td>{company.name}</td></tr>
                <tr><th scope="row">代表取締役</th><td>{company.representative}</td></tr>
                <tr><th scope="row">所在地</th><td>〒{company.postalCode} {company.address}</td></tr>
                <tr><th scope="row">電話番号</th><td><a class="num" href={company.telLink}>{company.telDisplay}</a></td></tr>
                <tr><th scope="row">メール</th><td><a href={`mailto:${company.email}`}>{company.email}</a></td></tr>
                <tr><th scope="row">営業時間</th><td><span class="num">{company.hours}</span>（休業日：{company.closed}）</td></tr>
                <tr><th scope="row">古物商許可</th><td>{company.license}</td></tr>
              </tbody>
            </table>
          </div>
        </div>
      </section>

      <section id="access" class="alt" aria-labelledby="access-h">
        <div class="wrap">
          <div class="sec-head" data-reveal>
            <span class="en">Access</span>
            <h2 id="access-h">アクセス</h2>
          </div>
          <div data-reveal>
            <div class="body-text">
              <p>〒{company.postalCode} {company.address}</p>
            </div>
            <a class="btn ghost" href={mapsUrl} rel="noopener" target="_blank">Googleマップで開く</a>
          </div>
        </div>
      </section>

      <section id="contact" aria-labelledby="contact-h">
        <div class="wrap">
          <div class="sec-head" data-reveal>
            <span class="en">Contact</span>
            <h2 id="contact-h">お問い合わせ</h2>
          </div>
          <div class="body-text" data-reveal>
            <p>取扱商品、商品の受取りなどについて、お気軽にお問い合わせください。お品物の画像をお送りいただく場合は、メールに添付してください。</p>
          </div>
          <div class="contact-grid">
            <div class="contact-card" data-reveal>
              <p class="k en">Phone</p>
              <p class="v num"><a href={company.telLink}>{company.telDisplay}</a></p>
            </div>
            <div class="contact-card" data-reveal style="--d:90ms">
              <p class="k en">Email</p>
              <p class="v"><a href={`mailto:${company.email}`}>{company.email}</a></p>
            </div>
            <!-- TODO: 先方作成のGoogleフォームURLが届いたら、ここにフォームへのボタンを追加する -->
          </div>
          <p class="note">営業時間 <span class="num">{company.hours}</span>／休業日 {company.closed}</p>
        </div>
      </section>
    </main>

    <footer>
      <div class="wrap footer-in">
        <span class="fname">開豊ジャパン</span>
        <small>〒{company.postalCode} {company.address} ／ <span class="num">{company.telDisplay}</span></small>
        <small>© {company.name}</small>
      </div>
    </footer>

    <script is:inline>
      (function () {
        var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        document.documentElement.classList.add('js');
        var targets = document.querySelectorAll('[data-reveal]');
        if (reduce || !('IntersectionObserver' in window)) {
          targets.forEach(function (el) { el.classList.add('in'); });
        } else {
          var io = new IntersectionObserver(function (entries) {
            entries.forEach(function (e) {
              if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
            });
          }, { threshold: 0.12, rootMargin: '0px 0px -6% 0px' });
          targets.forEach(function (el) { io.observe(el); });
        }
        if (reduce) return;
        var bar = document.getElementById('progress');
        var ghost = document.getElementById('heroGhost');
        var hero = document.querySelector('.hero');
        var ticking = false;
        function update() {
          ticking = false;
          var y = Math.max(0, window.scrollY || 0);
          var h = document.documentElement.scrollHeight - window.innerHeight;
          if (bar) bar.style.transform = 'scaleX(' + (h > 0 ? Math.min(y / h, 1) : 0) + ')';
          var heroH = hero ? hero.offsetHeight : window.innerHeight;
          if (ghost && y < heroH * 1.2) {
            ghost.style.transform = 'translateY(' + Math.min(y, heroH) * 0.3 + 'px)';
          }
        }
        window.addEventListener('scroll', function () {
          if (!ticking) { ticking = true; requestAnimationFrame(update); }
        }, { passive: true });
        update();
      })();
    </script>
  </body>
</html>
