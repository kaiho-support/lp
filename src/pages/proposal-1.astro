      <a href="#shop"><span class="n">09</span><span class="t">絵画</span></a>
      <a href="#shop"><span class="n">10</span><span class="t">美術装飾品</span></a>
      <a href="#shop"><span class="n">11</span><span class="t">その他美術品</span></a>
    </div>
  </section>


  <!-- 白磁：唯一の明るい井戸 -->
  <section class="ch bright">
