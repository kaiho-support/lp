  <!-- 取扱品目 -->
  <section class="ch" id="items">
    <div class="well"></div>
    <div class="head rv"><div class="no">CHAPTER 02 — COLLECTION</div><h2>取扱品目</h2><div class="rule"></div></div>
    <div class="index rv">
      <a href="#shop"><span class="n">01</span><span class="t">東洋美術</span></a>
      <a href="#shop"><span class="n">02</span><span class="t">西洋美術</span></a>
