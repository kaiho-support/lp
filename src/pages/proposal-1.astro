<script is:inline>
(function(){
  var v = document.getElementById('heroVid');
  var hero = document.getElementById('heroSec');
  var stage = hero ? hero.querySelector('.stage') : null;
  if(!v || !hero) return;
  if(window.matchMedia('(prefers-reduced-motion: reduce)').matches){ v.remove(); return; }
  var target = 0, cur = -1, seeking = false;
  function upd(){
    if(!v.duration || !stage) return;
    var total = hero.offsetHeight - stage.offsetHeight;
    var p = Math.min(1, Math.max(0, -hero.getBoundingClientRect().top / Math.max(1, total)));
    target = p * Math.max(0, v.duration - 0.06);
  }
  var seekWatch = null;
  function armWatch(){
    if(seekWatch) clearTimeout(seekWatch);
    seekWatch = setTimeout(function(){ seeking = false; }, 140);
  }
  function loop(){
    if(v.duration && !seeking && cur >= 0){
      if(!v.paused && !v.ended) v.pause();
      var diff = target - cur;
      if(Math.abs(diff) > 0.015){
        cur += diff * 0.16;
        seeking = true;
        armWatch();
        try{ v.currentTime = cur; }catch(e){ seeking = false; }
      }
    }
    requestAnimationFrame(loop);
  }
  v.addEventListener('loadedmetadata', function(){ cur = 0; upd(); });
  v.addEventListener('canplay', function(){ v.classList.add('live'); upd();
    var pr = v.play(); if(pr && pr.then){ pr.then(function(){ v.pause(); }).catch(function(){}); } });
  v.addEventListener('seeked', function(){ seeking = false; if(seekWatch) clearTimeout(seekWatch); });
  v.addEventListener('ended', function(){ cur = Math.max(0, v.duration - 0.06); try{ v.currentTime = cur; }catch(e){} });
  window.addEventListener('scroll', upd, {passive:true});
  var navLinks = document.querySelectorAll('.rail nav a[data-sec]');
  if('IntersectionObserver' in window && navLinks.length){
    var io = new IntersectionObserver(function(es){
      es.forEach(function(e){
        if(e.isIntersecting){
          navLinks.forEach(function(a){ a.classList.toggle('active', a.getAttribute('data-sec') === e.target.id); });
        }
      });
    }, {rootMargin:'-38% 0px -52% 0px'});
    ['about','items','shop','contact'].forEach(function(id){ var el = document.getElementById(id); if(el) io.observe(el); });
  }
  window.addEventListener('resize', upd);
  requestAnimationFrame(loop);
})();
</script>
