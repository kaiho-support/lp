<div class="tag">案3 — 一服の茶（スクロール映画）</div>
<script is:inline>
(function(){
  var v=document.getElementById('scrub'); if(!v) return;
  if(window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
  var film=document.querySelector('.film'), target=0, seeking=false;
  function upd(){ if(!v.duration) return; var total=film.offsetHeight-window.innerHeight; var p=Math.min(1,Math.max(0,-film.getBoundingClientRect().top/Math.max(1,total))); target=p*v.duration; }
  function tick(){ if(!v.duration||seeking) return; if(Math.abs(v.currentTime-target)>0.05){ seeking=true; try{ v.currentTime=target; }catch(e){ seeking=false; } } }
  v.addEventListener('canplay',function(){ v.classList.add('live'); upd(); tick(); });
  v.addEventListener('seeked',function(){ seeking=false; tick(); });
  window.addEventListener('scroll',function(){ upd(); tick(); },{passive:true});
  window.addEventListener('resize',function(){ upd(); tick(); });
})();
</script>
