<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="robots" content="noindex,nofollow">
<title>案3 一服の茶 — 開豊ジャパン</title>
<style>
:root{
  --bg:#060505; --ink:#ede8dc; --muted:#99937f; --line:rgba(237,232,220,.16);
  --serif:"Didot","Bodoni MT","Bodoni 72","Hiragino Mincho ProN","Hiragino Mincho Pro","YuMincho","Yu Mincho","Noto Serif CJK JP",serif;
  --sans:"Hiragino Kaku Gothic ProN","Hiragino Sans","Yu Gothic UI","Yu Gothic",sans-serif;
}
*{margin:0;padding:0;box-sizing:border-box}
body{background:var(--bg);color:var(--ink);font-family:var(--serif);line-height:1.9;-webkit-font-smoothing:antialiased;overflow-x:hidden}
img{display:block;max-width:100%}
a{color:inherit}
header.site{position:fixed;top:0;left:0;right:0;z-index:40;display:flex;justify-content:space-between;padding:20px clamp(20px,4vw,52px);mix-blend-mode:difference}
header.site .name{font-size:14px;letter-spacing:.34em}
header.site .tc{font-family:var(--sans);font-size:9.5px;letter-spacing:.3em;color:#cfc9ba}
/* FILM OPENING */
.film{height:360svh;position:relative}
.film .stage{position:sticky;top:0;height:100svh;overflow:hidden;background:#000}
.film .shot{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
.film video{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:0;transition:opacity .7s ease}
.film video.live{opacity:1}
.film .bar{position:absolute;left:0;right:0;height:11svh;background:#000;z-index:5}
.film .bar.top{top:0}.film .bar.bot{bottom:0}
.film .cap{position:absolute;left:0;right:0;bottom:16svh;z-index:6;text-align:center;opacity:0;padding:0 20px}
.film .cap .vol{font-family:var(--sans);font-size:9.5px;letter-spacing:.46em;color:var(--muted)}
.film .cap .line{font-size:clamp(21px,3.2vw,34px);letter-spacing:.22em;margin-top:12px;text-shadow:0 2px 30px rgba(0,0,0,.8)}
.film .cap.main{opacity:1}
.film .cap.main h1{font-size:clamp(38px,6vw,76px);font-weight:500;letter-spacing:.26em;text-indent:.26em}
.film .cap.main .sub{font-size:13.5px;letter-spacing:.4em;color:#d8d2c2;margin-top:14px}
@supports (animation-timeline: scroll()){
  @media (prefers-reduced-motion: no-preference){
    .film .bar{animation:barThin linear both;animation-timeline:scroll(root);animation-range:0 120svh}
    .film .cap.main{animation:capOut linear both;animation-timeline:scroll(root);animation-range:30svh 110svh}
    .film .cap.c2{animation:capMid linear both;animation-timeline:scroll(root);animation-range:120svh 260svh}
    .film .cap.c3{animation:capIn linear both;animation-timeline:scroll(root);animation-range:230svh 330svh}
  }
}
@keyframes barThin{to{height:5.5svh}}
@keyframes capOut{to{opacity:0;transform:translateY(-16px)}}
@keyframes capMid{0%{opacity:0}18%{opacity:1}72%{opacity:1}100%{opacity:0}}
@keyframes capIn{0%{opacity:0;transform:translateY(14px)}30%{opacity:1}100%{opacity:1;transform:none}}
/* BEATS */
.beat{height:130svh;position:relative}
.beat .stage{position:sticky;top:0;height:100svh;overflow:hidden}
.beat img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
.beat .cap{position:absolute;left:clamp(20px,5vw,72px);bottom:10svh;z-index:3;text-shadow:0 2px 26px rgba(0,0,0,.85)}
.beat .cap .vol{font-family:var(--sans);font-size:9.5px;letter-spacing:.46em;color:#c9c3b2}
.beat .cap .line{font-size:clamp(24px,3.6vw,40px);letter-spacing:.2em;margin-top:10px}
.beat .cap p{font-size:14px;color:#d8d2c2;letter-spacing:.08em;max-width:440px;margin-top:10px}
@supports (animation-timeline: view()){
  @media (prefers-reduced-motion: no-preference){
    .beat img{animation:beatZoom linear both;animation-timeline:view();animation-range:entry 0% exit 100%}
  }
}
@keyframes beatZoom{from{transform:scale(1.0)}to{transform:scale(1.09)}}
/* INFO on black */
section.info{padding:clamp(84px,13svh,150px) clamp(20px,5vw,72px);position:relative}
section.info .no{font-family:var(--sans);font-size:10px;letter-spacing:.42em;color:var(--muted)}
section.info h2{font-size:clamp(27px,3.4vw,40px);font-weight:500;letter-spacing:.18em;margin:14px 0 22px}
.lead{max-width:580px;color:#d9d3c3;font-size:15.5px;letter-spacing:.05em}
.index{border-top:1px solid var(--line);margin-top:8px}
.index div{display:flex;gap:clamp(16px,3vw,38px);align-items:baseline;padding:16px 4px;border-bottom:1px solid var(--line)}
.index .n{font-family:var(--sans);font-size:11px;color:var(--muted);min-width:32px}
.index .t{font-size:clamp(17px,2.1vw,23px);letter-spacing:.22em}
.index .e{margin-left:auto;font-family:var(--sans);font-size:9px;letter-spacing:.3em;color:var(--muted)}
@media(max-width:760px){.index .e{display:none}}
.btn{display:inline-block;margin-top:28px;padding:16px 38px;border:1px solid rgba(237,232,220,.55);text-decoration:none;font-family:var(--sans);font-size:11.5px;letter-spacing:.3em;transition:background .35s,color .35s}
.btn:hover{background:#ede8dc;color:#060505}
.kv{display:grid;grid-template-columns:170px 1fr;max-width:760px}
.kv dt,.kv dd{padding:14px 0;border-bottom:1px solid var(--line);font-size:14.5px;letter-spacing:.06em}
.kv dt{color:var(--muted);font-family:var(--sans);font-size:11px;letter-spacing:.24em;padding-top:18px}
@media(max-width:760px){.kv{grid-template-columns:108px 1fr}}
.cards{display:flex;gap:16px;flex-wrap:wrap}
.card{border:1px solid var(--line);padding:22px 26px;text-decoration:none;min-width:225px}
.card .k{font-family:var(--sans);font-size:9.5px;letter-spacing:.3em;color:var(--muted)}
.card .v{font-size:19px;letter-spacing:.1em;margin-top:6px}
footer{border-top:1px solid var(--line);padding:56px clamp(20px,5vw,72px) 46px;display:flex;justify-content:space-between;flex-wrap:wrap;gap:14px;font-family:var(--sans);font-size:10px;letter-spacing:.22em;color:var(--muted)}
footer .bars{display:flex;gap:5px}
footer .bars i{display:block;width:26px;height:5px;background:#3a372f}
.tag{position:fixed;left:14px;bottom:14px;z-index:80;background:#ede8dc;color:#060505;font-family:var(--sans);font-size:10px;letter-spacing:.18em;padding:7px 12px}
</style>
</head>
<body>
